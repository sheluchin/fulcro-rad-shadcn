{:paths ["src" "resources"]
 ;; The apps pin their own Fulcro and RAD; these are the versions this is built
 ;; and tested against.
 :deps  {com.fulcrologic/fulcro     {:mvn/version "3.8.2"}
         com.fulcrologic/fulcro-rad {:mvn/version "1.6.10"}}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps  {io.github.cognitect-labs/test-runner {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                       fulcrologic/fulcro-spec              {:mvn/version "3.1.12"}}
         :main-opts   ["-m" "cognitect.test-runner"]}}}
